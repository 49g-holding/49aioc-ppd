{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:49gaion:library:ppd:release-return:v0.1",
  "title": "Release return (Process and Position Design, blueprint Annex B)",
  "description": "A notice from a design stage to the stage that made the release it reads. It asks; it never changes the release. It names release parts, elements and fact-types, never a person.",
  "type": "object",
  "additionalProperties": false,
  "required": ["return_id", "run_id", "release", "kind", "elements", "evidence", "held_here", "status"],
  "properties": {
    "return_id": { "type": "string", "pattern": "^PPDR-[0-9]+$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9-]+$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_sha256"],
      "properties": {
        "release_id": { "type": "string", "pattern": "^[A-Z]+-?[a-f0-9]{64}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "kind": { "enum": ["accepted", "cannot use", "contradiction found", "assumption invalid", "request kind unsupported"] },
    "missing": { "type": "string", "minLength": 1, "description": "For cannot use: a fact-type or an element, never a person." },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part"],
        "properties": {
          "part": { "type": "string", "minLength": 1 },
          "element_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "description": "A release element ID or a source atom ID." },
          "span_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "held_here": { "type": "array", "items": { "type": "string" } },
    "filed_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "version", "sha256"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "status": { "enum": ["open", "answered by release", "answered by decision", "withdrawn"] },
    "answered_by": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "cannot use" } } }, "then": { "required": ["missing"] } },
    { "if": { "properties": { "kind": { "not": { "const": "accepted" } } } }, "then": { "properties": { "evidence": { "minItems": 1 } } } },
    { "if": { "properties": { "status": { "enum": ["answered by release", "answered by decision"] } } }, "then": { "required": ["answered_by"] } },
    { "if": { "properties": { "status": { "const": "open" } } }, "then": { "required": ["filed_ref"] } }
  ]
}
